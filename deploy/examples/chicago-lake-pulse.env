# Copy to /etc/chicago-lake-pulse.env, set mode 0600, and fill these only on the host.
# The checked-in deployment configuration remains in shadow mode independently.
LAKE_PULSE_BLUESKY_HANDLE=
LAKE_PULSE_BLUESKY_APP_PASSWORD=

# Defense-in-depth deployment gates. The application config is still authoritative.
PUBLISH_ENABLED=false
CAMERA_PUBLISH_ENABLED=false
CAMERA_RIGHTS_CONFIRMED=false
CAMERA_RIGHTS_REFERENCE=
