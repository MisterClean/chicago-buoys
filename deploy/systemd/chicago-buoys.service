[Unit]
Description=Chicago Buoys
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/chicago-buoys.env
ConditionPathExists=/etc/chicago-buoys-image.env
ConditionPathExists=/etc/chicago-buoys/config.yaml

[Service]
Type=oneshot
EnvironmentFile=/etc/chicago-buoys-image.env
ExecStartPre=-/usr/bin/docker rm -f chicago-buoys
ExecStart=/usr/bin/flock -n -E 0 /run/lock/chicago-buoys.lock /usr/bin/docker run --rm --pull never --name chicago-buoys --init --user 1000:1000 --pids-limit 64 --memory 192m --memory-swap 256m --cpus 0.75 --oom-score-adj 300 --ulimit nofile=1024:1024 --cap-drop ALL --security-opt no-new-privileges:true --read-only --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777 --log-driver journald --log-opt tag=chicago-buoys --env-file /etc/chicago-buoys.env --env CONFIG_PATH=/app/config/runtime.yaml --env DATABASE_PATH=/state/chicago-buoys.sqlite --env BLUESKY_SESSION_PATH=/state/bluesky-session.json --mount type=bind,src=/etc/chicago-buoys/config.yaml,dst=/app/config/runtime.yaml,readonly --mount type=bind,src=/var/lib/chicago-buoys,dst=/state ${CHICAGO_BUOYS_IMAGE} tick --config /app/config/runtime.yaml --database /state/chicago-buoys.sqlite
ExecStopPost=-/usr/bin/docker rm -f chicago-buoys
TimeoutStartSec=8min
TimeoutStopSec=30s
Nice=10
IOSchedulingClass=idle
UMask=0077
