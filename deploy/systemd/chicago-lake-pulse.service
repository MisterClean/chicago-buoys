[Unit]
Description=Chicago Lake Pulse
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/chicago-lake-pulse.env
ConditionPathExists=/etc/chicago-lake-pulse-image.env
ConditionPathExists=/etc/chicago-lake-pulse/config.yaml

[Service]
Type=oneshot
EnvironmentFile=/etc/chicago-lake-pulse-image.env
ExecStartPre=-/usr/bin/docker rm -f chicago-lake-pulse
ExecStart=/usr/bin/flock -n -E 0 /run/lock/chicago-lake-pulse.lock /usr/bin/docker run --rm --pull never --name chicago-lake-pulse --init --user 1000:1000 --pids-limit 64 --memory 192m --memory-swap 256m --cpus 0.75 --oom-score-adj 300 --ulimit nofile=1024:1024 --cap-drop ALL --security-opt no-new-privileges:true --read-only --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777 --log-driver journald --log-opt tag=chicago-lake-pulse --env-file /etc/chicago-lake-pulse.env --env CONFIG_PATH=/app/config/runtime.yaml --env DATABASE_PATH=/state/pulse.sqlite --env BLUESKY_SESSION_PATH=/state/bluesky-session.json --mount type=bind,src=/etc/chicago-lake-pulse/config.yaml,dst=/app/config/runtime.yaml,readonly --mount type=bind,src=/var/lib/chicago-lake-pulse,dst=/state ${CHICAGO_LAKE_PULSE_IMAGE} tick --config /app/config/runtime.yaml --database /state/pulse.sqlite
ExecStopPost=-/usr/bin/docker rm -f chicago-lake-pulse
TimeoutStartSec=8min
TimeoutStopSec=30s
Nice=10
IOSchedulingClass=idle
UMask=0077
