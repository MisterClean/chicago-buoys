# Copy these names into a private runtime environment file.
# Never commit real values or a generated Bluesky session.

CHICAGO_BUOYS_CONFIG=./config.yaml
DATABASE_PATH=./var/chicago-buoys.sqlite

CHICAGO_BUOYS_BLUESKY_HANDLE=
CHICAGO_BUOYS_BLUESKY_APP_PASSWORD=

# Defense-in-depth deployment gates. The YAML gates must also allow publishing.
PUBLISH_ENABLED=false
CAMERA_PUBLISH_ENABLED=false
CAMERA_RIGHTS_CONFIRMED=false
CAMERA_RIGHTS_REFERENCE=
